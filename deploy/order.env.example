# Настройки сервиса заказов.
#
# На сервере: скопировать в /etc/autosvet-order.env, заполнить и закрыть
# права: sudo chmod 600 /etc/autosvet-order.env
#
# Локально для проверки: скопировать в корень проекта под именем .env
# (он в .gitignore, в репозиторий не попадёт).

# --- Telegram --------------------------------------------------------
# 1. Написать @BotFather в Telegram, команда /newbot, придумать имя.
#    В ответ придёт токен вида 1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# 2. Куда присылать заказы. Проще всего: написать своему боту любое
#    сообщение, затем открыть в браузере
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates
#    и взять оттуда значение result[0].message.chat.id
#
#    Для группы: добавить бота в группу, отправить туда сообщение и взять
#    chat.id из того же getUpdates (у групп он отрицательный, например
#    -1001234567890).
TELEGRAM_CHAT_ID=

# --- Сеть ------------------------------------------------------------
# Слушаем только localhost: снаружи сервис доступен исключительно через
# nginx. Менять на 0.0.0.0 не нужно.
HOST=127.0.0.1
PORT=8787

# --- Файлы -----------------------------------------------------------
# Прайс из сборки сайта: по нему пересчитываются суммы заказа.
VARIANTS_FILE=/var/www/auto-svet.by/current/variants.json

# Журнал заказов. Каждая заявка — одна строка JSON. Пишется до отправки в
# Telegram, поэтому заказ не теряется даже если мессенджер недоступен.
ORDERS_LOG=/var/www/auto-svet.by/orders/orders.jsonl

# Сколько ПРИНЯТЫХ заказов допускаем с одного IP за 10 минут.
# Отклонённые заявки (опечатка в телефоне, пустая корзина) в этот счётчик не
# попадают — иначе живой клиент, ошибившийся пару раз, получил бы блокировку.
# Флуд запросами ограничен отдельно, порогом 40 за те же 10 минут.
RATE_LIMIT=5
