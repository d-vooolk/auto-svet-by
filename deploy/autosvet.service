# ------------------------------------------------------------------
# systemd-юнит для сайта.
#
# Раньше юнитов было два: nginx раздавал статику, а отдельный процесс на
# порту 8787 принимал заказы. Теперь приложение живое и делает обе работы
# само — юнит остался один.
#
# Установка:
#   sudo cp deploy/autosvet.service /etc/systemd/system/
#   sudo cp deploy/../.env.example /etc/autosvet.env
#   sudo nano /etc/autosvet.env          # вписать токен бота и chat_id
#   sudo chown root:root /etc/autosvet.env && sudo chmod 600 /etc/autosvet.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now autosvet
#
# Проверка:  systemctl status autosvet
#            journalctl -u autosvet -f
#            curl -I localhost:3000
# ------------------------------------------------------------------

[Unit]
Description=Autosvet BY — магазин автосвета (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data

WorkingDirectory=/var/www/auto-svet.by/app

# Вызываем next напрямую, а не через `npm start`: иначе между systemd и
# сервером висит лишний процесс npm, и сигнал остановки до Node доходит
# через посредника.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3000

Environment=NODE_ENV=production
# Токен бота лежит здесь, а не в юните: юнит читается всеми, файл — только root.
EnvironmentFile=/etc/autosvet.env

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autosvet

# ---------------------------------------------------------------
# Песочница
# ---------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

# MemoryDenyWriteExecute здесь нельзя: V8 компилирует JavaScript в машинный
# код на лету, ему нужна память с правом записи и исполнения. У прежнего
# сервиса заказов ограничение стояло, и это было уместно — там был крошечный
# скрипт без нагрузки. Полноценный Next с ним просто не запустится.

# Три папки, куда приложению нужно писать. Всё остальное только на чтение.
ReadWritePaths=/var/www/auto-svet.by/app/var
ReadWritePaths=/var/www/auto-svet.by/app/public/img
# .next/cache — сюда Next кладёт пересобранные страницы, когда админка
# вызывает revalidatePath. Без права записи правки не появятся на витрине.
ReadWritePaths=/var/www/auto-svet.by/app/.next

[Install]
WantedBy=multi-user.target
